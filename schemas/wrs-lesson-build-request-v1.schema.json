{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://wrs-dojo.local/schemas/wrs-lesson-build-request-v1.schema.json","title":"WRS Lesson Build Request v1","description":"Single orchestration request joining current group state, one verified Substep packet, selection history, and protocol/contract versions.","type":"object","additionalProperties":false,"required":["schemaVersion","requestId","createdAt","groupSnapshotRef","sourcePacketRef","protocolVersion","teacherPlanContractVersion","runtimeSchemaVersion","plannedDate","lessonRoute","teacherDecisions"],"properties":{"schemaVersion":{"const":"wrs-lesson-build-request-v1"},"requestId":{"type":"string","minLength":1},"createdAt":{"type":"string","format":"date-time"},"groupSnapshotRef":{"type":"string","minLength":1},"sourcePacketRef":{"type":"string","minLength":1},"selectionHistoryRef":{"type":["string","null"]},"protocolVersion":{"type":"string","minLength":1},"teacherPlanContractVersion":{"const":"wrs-teacher-plan-contract-v1"},"runtimeSchemaVersion":{"const":"wrs-runtime-v1"},"plannedDate":{"type":"string","format":"date"},"lessonRoute":{"enum":["full","block1+3","block2+3","continuation"]},"teacherDecisions":{"type":"object","additionalProperties":false,"required":["focus","advancementOverride"],"properties":{"focus":{"enum":["use-snapshot","introduction","accuracy","automaticity-fluency"]},"advancementOverride":{"enum":["none","continue","advance"]},"notes":{"type":"string"}}}}}